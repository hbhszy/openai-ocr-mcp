OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
# OPENAI_API_MODE=responses  # "chat" (default) or "responses"
OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_OUTPUT_DIR=generated_images

# Optional structured config file. If omitted, ./config.json is used when it exists.
# Tool-specific values in this file override top-level values, while
# tool-specific env vars override the file.
# OPENAI_OCR_MCP_CONFIG=./config.json

# Optional per-tool env overrides
# OPENAI_OCR_API_KEY=sk-xxx
# OPENAI_OCR_BASE_URL=https://api.openai.com/v1
# OPENAI_OCR_MODEL=gpt-5.4
# OPENAI_OCR_API_MODE=chat

# OPENAI_GENERATE_IMAGE_API_KEY=sk-xxx
# OPENAI_GENERATE_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_GENERATE_IMAGE_MODEL=gpt-image-2

# OPENAI_EDIT_IMAGE_API_KEY=sk-xxx
# OPENAI_EDIT_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_EDIT_IMAGE_MODEL=gpt-image-2
